# TenderFit Environment Configuration

# Database Configuration (PostgreSQL default; auto-falls back to SQLite if Postgres is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenderfit_db

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Storage Paths
COMPANY_DOCS_DIR=documents/company_documents
TENDER_DOCS_DIR=documents/tender_documents
REPORTS_DIR=reports

# Gemini AI (for future milestone)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Playwright Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

